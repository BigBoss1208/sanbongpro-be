# Template only: configure these in Render Environment; Spring does not load .env automatically.
SPRING_PROFILES_ACTIVE=cloud
# Render provides PORT. Use 8084 for local verification only.
# PORT=8084
# JDBC URL without credentials. Replace host/db with your Neon project's values.
DB_URL=jdbc:postgresql://NEON_HOST:5432/NEON_DATABASE?sslmode=verify-full
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
CORS_ORIGINS=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_REGION=us-east-1
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# On Render, OMIT this variable to derive it from RENDER_EXTERNAL_URL.
# For local/custom hosting, set the real Backend URL explicitly (not a blank value).
# VNPAY_RETURN_URL=https://YOUR_BACKEND/api/thanh-toan/vnpay/return
VNPAY_IPN_URL=
VNPAY_FRONTEND_RESULT_URL=
VNPAY_RETURN_SETTLEMENT_ENABLED=true
GMAIL_ENABLED=false
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
API_DOCS_ENABLED=false
DEMO_SEED_ENABLED=false
